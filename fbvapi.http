### register a new user
POST {{baseUrl}}/auth/register/
Content-Type: application/json

{
    "email": "abc@gmail.com",
    "first_name":"abcd",
    "last_name":"efg",
    "password": "admin123@?",
    "password2": "admin123@?"
}

### login registered user


POST {{baseUrl}}/auth/login/
Content-Type: application/json

{
    "email": "habib@gmail.com",
    "password": "admin123@?"
}

###

POST {{baseUrl}}/auth/token/refresh/
Content-Type: application/json

{
    "refresh": "{{refreshToken}}"
}

### logout

POST {{baseUrl}}/auth/logout/
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "refresh_token": "{{refreshToken}}"
}

### get todo list

GET {{baseUrl}}/api/todos/
Authorization: Bearer {{accessToken}}

###create new todo

POST {{baseUrl}}/api/todos/
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "title": "Learn django testing",
    "description": "Build a professional multi-user Todo API test api using django testing",
    "status": "Pending",
    "priority": "High"
}

### retrive todos by id

GET {{baseUrl}}/api/todos/9/
Authorization: Bearer {{accessToken}}


### pertial update

PATCH {{baseUrl}}/api/todos/9/
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "status": "Completed"
}


###full update 
PUT {{baseUrl}}/api/todos/9/
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "title": "Learn django testing with pytest",
    "description": "Build a professional multi-user Todo API test api using django testing and pytest",
    "status": "Pending",
    "priority": "Low"
}

### delete todo

DELETE {{baseUrl}}/api/todos/10/
Authorization: Bearer {{accessToken}}



### get todo list by paginator

GET {{baseUrl}}/api/todos/?page=2
Authorization: Bearer {{accessToken}}

### filtering by status

GET {{baseUrl}}/api/todos/?status=Pending
Authorization: Bearer {{accessToken}}


### filter by priority

GET {{baseUrl}}/api/todos/?priority=High
Authorization: Bearer {{accessToken}}



### searching by title and description

GET {{baseUrl}}/api/todos/?search=django
Authorization: Bearer {{accessToken}}


### ordering by id or created_at
GET {{baseUrl}}/api/todos/?ordering=-created_at
Authorization: Bearer {{accessToken}}

### filtering , searching , ordering together

GET {{baseUrl}}/api/todos/?status=Pending&priority=Low&search=learn&ordering=-created_at
Authorization: Bearer {{accessToken}}
