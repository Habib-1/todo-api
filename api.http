### register a new user
POST {{baseUrl}}/auth/register/
Content-Type: application/json

{
    "email": "habib@gmail.com",
    "first_name":"Habib",
    "last_name":"Biswas",
    "password": "admin123@?",
    "password2": "admin123@?"
}

### login registered user


POST {{baseUrl}}/auth/login/
Content-Type: application/json

{
    "email": "habib@gmail.com",
    "password": "admin123@?"
}

###

POST {{baseUrl}}/auth/token/refresh/
Content-Type: application/json

{
    "refresh": "{{refreshToken}}"
}

### all todo list of logged in user

GET {{baseUrl}}/api/todos/
Authorization: Bearer {{accessToken}}

###create new todo

POST {{baseUrl}}/api/todos/
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "title": "Learn React router",
    "description": "Build a professional multi-user Todo API",
    "status": "Pending",
    "priority": "Low"
}

### retrive todos by id

GET {{baseUrl}}/api/todos/1/
Authorization: Bearer {{accessToken}}

### update todos by id

PATCH {{baseUrl}}/api/todos/1/
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "status": "Completed"
}

###

GET {{baseUrl}}/api/todos/?search=nextjs
Authorization: Bearer {{accessToken}}

### filtering by priority and status

GET {{baseUrl}}/api/todos/?status=Pending
Authorization: Bearer {{accessToken}}

###

GET {{baseUrl}}/api/todos/?priority=High
Authorization: Bearer {{accessToken}}

###

GET {{baseUrl}}/api/todos/?ordering=-created_at
Authorization: Bearer {{accessToken}}

###

GET {{baseUrl}}/api/todos/?page=2
Authorization: Bearer {{accessToken}}

### delete todos by id

DELETE {{baseUrl}}/api/todos/4/
Authorization: Bearer {{accessToken}}


### logout user by blocking refresh token
POST {{baseUrl}}/auth/logout/
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "refresh_token": "{{refreshToken}}"
}