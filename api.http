### register a new user
POST {{baseUrl}}/auth/register/
Content-Type: application/json

{
    "email": "habib@gmail.com",
    "first_name":"Habib",
    "last_name":"Biswas",
    "password": "admin123@?",
    "password2": "admin123@?"
}

### login registered user


POST {{baseUrl}}/auth/login/
Content-Type: application/json

{
    "email": "admin@gmail.com",
    "password": "admin123"
}

###

POST {{baseUrl}}/auth/token/refresh/
Content-Type: application/json

{
    "refresh": "{{refreshToken}}"
}

### all todo list of logged in user

GET {{baseUrl}}/api/todos/
Authorization: Bearer {{accessToken}}

###create new todo

POST {{baseUrl}}/api/todos/
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "title": "Learn NextJs",
    "description": "Build a professional multi-user Todo API",
    "status": "Pending",
    "priority": "High"
}

### retrive todos by id

GET {{baseUrl}}/api/todos/1/
Authorization: Bearer {{accessToken}}

### update todos by id

PATCH {{baseUrl}}/api/todos/1/
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "status": "Completed"
}

###

GET {{baseUrl}}/api/todos/?search=django
Authorization: Bearer {{accessToken}}

###

GET {{baseUrl}}/api/todos/?status=pending
Authorization: Bearer {{accessToken}}

###

GET {{baseUrl}}/api/todos/?priority=high
Authorization: Bearer {{accessToken}}

###

GET {{baseUrl}}/api/todos/?ordering=-created_at
Authorization: Bearer {{accessToken}}

###

GET {{baseUrl}}/api/todos/?page=1
Authorization: Bearer {{accessToken}}

### delete todos by id

DELETE {{baseUrl}}/api/todos/1/
Authorization: Bearer {{accessToken}}